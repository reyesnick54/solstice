# SunRey sandbox environment template (local development)
#
# Copy to `.env` and adjust for your deployment. Never commit real secrets.
#
# Hetzner production-sandbox template:
#   infra/sandbox/env.production-sandbox.example
#   deploy/sunrey-sandbox-hetzner/

ENVIRONMENT=simulation
SUNREY_DEPLOYMENT_TIER=staging

# Internal operator token (required for /internal/v1/* routes)
SUNREY_INTERNAL_OPERATOR_TOKEN=replace-with-long-random-token

# Platform API
SUNREY_API_HOST=0.0.0.0
SUNREY_API_PORT=8080
SUNREY_DATABASE_URL=postgres://solstice_bootstrap:solstice_dev_only_not_for_production@localhost:5432/postgres
SUNREY_FEATURE_REQUIRE_PERSISTENCE_FOR_READY=true

# Consumer BFF / preview
SUNREY_PREVIEW_SANDBOX_PERSONAS=true
SUNREY_PREVIEW_AUTH_ENABLED=true
SUNREY_PREVIEW_ALLOW_LOCAL_ORIGINS=true
SUNREY_API_ALLOWED_ORIGINS=http://localhost:3000,https://app.sunrey.xyz

# Product domains (configure reverse proxy / TLS separately)
SUNREY_PUBLIC_APP_ORIGIN=https://app.sunrey.xyz
SUNREY_PUBLIC_API_ORIGIN=https://api.sunrey.xyz

# Simulation posture (must remain false)
LIVE_CONNECTIVITY_ENABLED=false
PRODUCTION_ACTIVE=false

# Access Live Provider Fabric (Internal Alpha read integrations)
VAST_API_KEY=
TICKETMASTER_API_KEY=
EIA_API_KEY=
OPEN_CHARGE_MAP_API_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
YELP_ENABLED=false
YELP_API_KEY=
RUN_LIVE_PROVIDER_SMOKE_TESTS=false
