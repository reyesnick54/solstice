# SunRey Simulation RC2 — Hetzner production-sandbox environment template
#
# Copy to deploy/sunrey-sandbox-hetzner/.env and replace every REPLACE_* value.
# Never commit a filled .env file.

# --- Simulation posture (do not change for sandbox) ---
ENVIRONMENT=simulation
SUNREY_DEPLOYMENT_TIER=staging
LIVE_CONNECTIVITY_ENABLED=false
PRODUCTION_ACTIVE=false
PRODUCTION_READY=false

# --- Public product origins ---
SUNREY_PUBLIC_APP_ORIGIN=https://app.sunrey.xyz
SUNREY_PUBLIC_API_ORIGIN=https://api.sunrey.xyz
SUNREY_API_ALLOWED_ORIGINS=https://app.sunrey.xyz

# --- Consumer BFF / preview sandbox auth ---
SUNREY_PREVIEW_SANDBOX_PERSONAS=true
SUNREY_PREVIEW_AUTH_ENABLED=true
SUNREY_PREVIEW_ALLOW_LOCAL_ORIGINS=false
SUNREY_PREVIEW_AUTH_EMAIL=REPLACE_PREVIEW_LOGIN_EMAIL
SUNREY_PREVIEW_AUTH_PASSWORD=REPLACE_PREVIEW_LOGIN_PASSWORD_MIN_12_CHARS

# --- External AI preview (research only; does not enable financial execution) ---
SUNREY_EXTERNAL_AI_PREVIEW_ENABLED=false
SUNREY_MARKET_RESEARCH_UNIVERSE=SPY,QQQ
XAI_BASE_URL=https://api.x.ai
XAI_RESPONSES_PATH=/v1/responses
XAI_MODEL=grok-4.6
XAI_TIMEOUT_MS=30000
XAI_MAX_OUTPUT_TOKENS=4096
XAI_CREDENTIAL_REF=secret://cloud-run/xai-api-key
XAI_WEB_SEARCH_ENABLED=false
XAI_X_SEARCH_ENABLED=false
SUNREY_SECRET_XAI_API_KEY=REPLACE_XAI_API_KEY_IF_ENABLED

# --- Readiness ---
SUNREY_FEATURE_REQUIRE_PERSISTENCE_FOR_READY=true

# --- PostgreSQL bootstrap (internal network only) ---
SUNREY_PG_BOOTSTRAP_USER=REPLACE_PG_BOOTSTRAP_USER
SUNREY_PG_BOOTSTRAP_PASSWORD=REPLACE_PG_BOOTSTRAP_PASSWORD
SUNREY_PG_MIGRATOR_USER=REPLACE_PG_MIGRATOR_USER
SUNREY_PG_MIGRATOR_PASSWORD=REPLACE_PG_MIGRATOR_PASSWORD
SUNREY_PG_CUSTOMER_USER=REPLACE_PG_CUSTOMER_USER
SUNREY_PG_CUSTOMER_PASSWORD=REPLACE_PG_CUSTOMER_PASSWORD
SUNREY_PG_LEDGER_USER=REPLACE_PG_LEDGER_USER
SUNREY_PG_LEDGER_PASSWORD=REPLACE_PG_LEDGER_PASSWORD
SUNREY_PG_EVIDENCE_USER=REPLACE_PG_EVIDENCE_USER
SUNREY_PG_EVIDENCE_PASSWORD=REPLACE_PG_EVIDENCE_PASSWORD
SUNREY_PG_SECURITY_USER=REPLACE_PG_SECURITY_USER
SUNREY_PG_SECURITY_PASSWORD=REPLACE_PG_SECURITY_PASSWORD

# --- Optional build metadata ---
SUNREY_SOURCE_COMMIT=REPLACE_GIT_TAG_OR_SHA
