{
  "name": "solstice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Solstice digital banking — Compliance Kernel, simulated Global Money Fabric, and Pyramid Economy (simulation)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint:invariants": "python3 scripts/lint-architectural-invariants.py",
    "check:extraction": "python3 scripts/extraction-dryrun.py",
    "check:posture": "python3 scripts/check-deployment-posture.py",
    "gate": "node scripts/check-kernel-gating.mjs",
    "test": "npm test --workspaces --if-present && node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/phase-8-exit.test.ts tests/growth-attribution.test.ts",
    "demo": "npm run demo -w @solstice/demo",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "scan:secrets": "python3 scripts/secret-scan.py",
    "ci": "bash scripts/ci.sh"
  },
  "devDependencies": {
    "@types/node": "^24.2.1"
  }
}
