{
  "name": "solstice",
  "version": "0.1.0",
  "private": true,
  "description": "Solstice Phase 0 banking simulation — ledger-authoritative, simulation only",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx src/demo.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  "description": "Solstice digital banking — class-segregated balances derived from ledger postings",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tsx --test tests/**/*.test.ts",
    "demo": "tsx demo/demo.ts",
    "typecheck": "tsc --noEmit",
    "suite": "tsx --test tests/**/*.test.ts && tsx demo/demo.ts"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
