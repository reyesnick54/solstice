{
  "name": "solstice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Solstice digital banking — Compliance Kernel, Personal Economy Agent, and Personal Data Fabric",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint:invariants": "python3 scripts/lint-architectural-invariants.py",
    "check:extraction": "python3 scripts/extraction-dryrun.py",
    "check:posture": "python3 scripts/check-deployment-posture.py",
    "gate": "node scripts/check-kernel-gating.mjs",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test $(find packages tests -name '*.test.ts' 2>/dev/null | sort)",
    "demo": "npm run demo -w @solstice/demo && npm run demo -w @solstice/data-fabric --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "scan:secrets": "python3 scripts/secret-scan.py",
    "ci": "bash scripts/ci.sh"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "typescript": "^5.9.2"
  }
}
