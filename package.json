{
  "name": "solstice",
  "version": "0.1.0",
  "private": true,
  "description": "Solstice — Personal Economy Agent and Growth OS (propose-only)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test packages/domain/src/**/*.test.ts tests/**/*.test.ts",
    "demo": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/platform/src/demo.ts",
    "typecheck": "tsc --noEmit -p packages/domain/tsconfig.json && tsc --noEmit -p packages/contracts/tsconfig.json",
    "ci": "npm test && npm run demo"
  }
}
