{
  "name": "solstice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Solstice digital banking simulation \u2014 Compliance Kernel, signed Execution Authority, Evidence Vault",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-reporter=spec packages/domain/src/*.test.ts packages/money/src/*.test.ts packages/permissions/src/*.test.ts packages/security/src/*.test.ts packages/identity/src/*.test.ts packages/evidence/src/*.test.ts packages/ledger/src/*.test.ts packages/events/src/*.test.ts packages/persistence/src/*.test.ts packages/kernel/src/**/*.test.ts packages/payments/src/*.test.ts packages/cards/src/*.test.ts packages/personal-economic-graph/src/*.test.ts packages/agent/src/*.test.ts packages/platform/src/**/*.test.ts packages/treasury/src/*.test.ts packages/investments/src/*.test.ts packages/regulatory-twin/src/*.test.ts packages/risk/src/*.test.ts packages/model-registry/src/*.test.ts packages/strategy-lab/src/*.test.ts packages/agentic-capital-mesh/src/*.test.ts packages/personal-data-vault/src/*.test.ts packages/consent/src/*.test.ts packages/clean-room/src/*.test.ts packages/sunrey-coin/src/*.test.ts packages/information-market/src/*.test.ts packages/sunrey-chain/src/*.test.ts packages/sunrey-chain/src/local-node/*.test.ts packages/sunrey-exchange/src/*.test.ts packages/custody/src/*.test.ts packages/market-surveillance/src/*.test.ts services/accounts/src/*.test.ts tools/architectural-linter/src/*.test.ts tests/*.test.ts",
    "policy:diff": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/policy-diff.mjs",
    "test:persistence": "SOLSTICE_PERSISTENCE_TEST=1 node --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-concurrency=1 --test-reporter=spec tests/persistence/*.test.ts",
    "test:events": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-reporter=spec packages/events/src/*.test.ts",
    "events:outbox": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/events-inspect.mjs outbox",
    "events:inbox": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/events-inspect.mjs inbox",
    "events:dead-letters": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/events-inspect.mjs dead-letters",
    "events:dispatch": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/events-dispatch.mjs",
    "events:replay": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/events-replay.mjs",
    "db:up": "bash scripts/postgres-up.sh",
    "db:bootstrap": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/postgres-bootstrap.mjs",
    "db:migrate": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/postgres-migrate.mjs",
    "db:down": "bash scripts/postgres-down.sh",
    "demo": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/domain/src/demo.ts",
    "demo:cards": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/cards/src/demo.ts",
    "demo:peg": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/personal-economic-graph/src/demo.ts",
    "demo:wallet": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/cards/src/demo-wallet.ts",
    "demo:acceptance": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/cards/src/demo-acceptance.ts",
    "demo:growth": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/platform/src/demo.ts",
    "demo:peve": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/platform/src/value/demo.ts",
    "demo:treasury": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/treasury/src/demo.ts",
    "demo:investments": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/investments/src/demo.ts",
    "demo:rdt": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/regulatory-twin/src/demo.ts",
    "demo:risk": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/risk/src/demo.ts",
    "demo:pdv": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/personal-data-vault/src/demo.ts",
    "demo:strategy-lab": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/strategy-lab/src/demo.ts",
    "demo:mesh": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/agentic-capital-mesh/src/demo.ts",
    "demo:consent": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/consent/src/demo.ts",
    "demo:clean-room": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/clean-room/src/demo.ts",
    "demo:sunrey-coin": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/sunrey-coin/src/demo.ts",
    "demo:information-market": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/information-market/src/demo.ts",
    "demo:sunrey-chain": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/sunrey-chain/src/demo.ts",
    "demo:sunrey-node": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/sunrey-chain/src/local-node/demo.ts",
    "demo:sunrey-governance": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/sunrey-chain/src/governance/demo.ts",
    "demo:moonrey-productive": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/sunrey-chain/src/productive/demo.ts",
    "demo:sunrey-oracle": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/sunrey-chain/src/oracle/demo.ts",
    "demo:sunrey-fees": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/sunrey-chain/src/fees/demo.ts",
    "demo:sunrey-devnet": "bash -lc 'cd packages/sunrey-chain/node && cargo run --bin sunrey-devnet'",
    "demo:sunrey-validator-devnet": "bash -lc 'cd packages/sunrey-chain/node && cargo run --bin sunrey-validator-devnet'",
    "demo:sunrey-accountability": "bash -lc 'cd packages/sunrey-chain/node && cargo run --bin sunrey-accountability-demo'",
    "demo:sunrey-native-assets": "bash -lc 'cd packages/sunrey-chain/node && cargo run --bin sunrey-native-asset-demo'",
    "test:sunrey-node": "bash -lc 'cd packages/sunrey-chain/node && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test --locked'",
    "demo:sunrey-exchange": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/sunrey-exchange/src/demo.ts",
    "demo:custody": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/custody/src/demo.ts",
    "demo:travel-rule": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/custody/src/demo.ts",
    "demo:withdrawal": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/custody/src/demo.ts",
    "demo:market-surveillance": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/market-surveillance/src/demo.ts",
    "demo:listing-governance": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/sunrey-exchange/src/listing-demo.ts",
    "lint:architecture": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/architectural-linter/src/cli.ts",
    "lint:invariants": "python3 scripts/lint-architectural-invariants.py",
    "check:extraction": "python3 scripts/extraction-dryrun.py",
    "check:posture": "python3 scripts/check-deployment-posture.py",
    "scan:secrets": "python3 scripts/secret-scan.py && python3 scripts/secret-scan.py --self-test",
    "gate": "node scripts/check-kernel-gating.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "ci": "bash scripts/ci.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.0.0"
  }
}
