{
  "name": "@solstice/sunrey-sdk",
  "version": "0.1.0",
  "description": "SunRey SDK — official developer SDK and versioned public API adapter",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./consumer": "./src/consumer-platform/index.ts",
    "./consumer-bff": "./src/consumer-bff/index.ts"
  },
  "files": [
    "src",
    "examples"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test src/**/*.test.ts",
    "demo": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/demo.ts",
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/dev.ts",
    "sunrey-dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/developer-platform/cli-main.ts",
    "quickstart": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/quickstart.ts",
    "generate:api-reference": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/generate-reference.ts"
  },
  "engines": {
    "node": ">=22"
  }
}
