# SunRey Access Live Provider Fabric — Internal Alpha credentials
# Copy values into your deployment environment. Never commit real secrets.

# Compute / AI
VAST_API_KEY=

# Experiences
TICKETMASTER_API_KEY=

# Energy reference data
EIA_API_KEY=

# EV charging (optional key; public API works without it)
OPEN_CHARGE_MAP_API_KEY=

# Goods discovery (OAuth client credentials)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# Optional — billing account required, disabled by default
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=

# Optional — trial/paid, disabled by default
YELP_ENABLED=false
YELP_API_KEY=

# Opt-in live smoke test script
RUN_LIVE_PROVIDER_SMOKE_TESTS=false
