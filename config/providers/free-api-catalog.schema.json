{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunrey.dev/schemas/free-api-catalog.schema.json",
  "title": "SunRey Free API Provider Catalog",
  "description": "Machine-readable registry for external free/public API providers. Credentials must never appear in catalog files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "expected_provider_count",
    "population_status",
    "providers"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "catalog_id": {
      "type": "string",
      "const": "sunrey-free-api-catalog"
    },
    "expected_provider_count": {
      "type": "integer",
      "const": 126
    },
    "population_status": {
      "type": "string",
      "enum": ["awaiting_master_list", "populated", "partial"]
    },
    "source_list": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "document": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "verified_at": { "type": ["string", "null"], "format": "date" }
      }
    },
    "notes": { "type": ["string", "null"] },
    "providers": {
      "type": "array",
      "items": { "$ref": "#/$defs/provider" }
    }
  },
  "$defs": {
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "category": {
      "type": "string",
      "enum": [
        "macroeconomics",
        "foreign_exchange",
        "markets",
        "securities",
        "commodities",
        "corporate_filings",
        "cryptocurrency",
        "blockchain",
        "compliance",
        "kyb_identity",
        "fraud_risk",
        "cybersecurity",
        "energy",
        "natural_resources",
        "environmental",
        "weather",
        "water",
        "transportation",
        "aviation",
        "maritime",
        "travel",
        "geospatial",
        "logistics",
        "health",
        "food_nutrition",
        "jobs_skills",
        "research",
        "patents",
        "government_open_data",
        "artificial_intelligence",
        "other"
      ]
    },
    "authority_class": {
      "type": "string",
      "enum": [
        "authoritative_official",
        "regulated_provider",
        "reference_data",
        "research_data",
        "community_data",
        "derived_data"
      ]
    },
    "priority": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"]
    },
    "launch_tier": {
      "type": "string",
      "enum": [
        "production_candidate",
        "secondary_source",
        "fallback_source",
        "research_only",
        "blocked_pending_review"
      ]
    },
    "verification_status": {
      "type": "string",
      "enum": ["verified", "partially_verified", "unverified", "deprecated", "unavailable"]
    },
    "free_access_status": {
      "type": "string",
      "enum": ["verified_free", "free_tier", "trial_only", "unclear", "no_longer_free"]
    },
    "commercial_use_status": {
      "type": "string",
      "enum": [
        "verified_allowed",
        "restricted",
        "attribution_required",
        "noncommercial_only",
        "unclear",
        "unknown",
        "requires_legal_review"
      ]
    },
    "redistribution_status": {
      "type": "string",
      "enum": [
        "allowed",
        "attribution_required",
        "restricted",
        "prohibited",
        "unclear",
        "unknown"
      ]
    },
    "authentication_type": {
      "type": "string",
      "enum": ["none", "api_key", "oauth", "bearer_token", "basic_auth", "other"]
    },
    "sunrey_domain": {
      "type": "string",
      "enum": [
        "world",
        "grow",
        "financial_agent",
        "exchange",
        "blockchain_intelligence",
        "moonrey",
        "hin",
        "vault",
        "travel",
        "compliance",
        "cybersecurity",
        "economic_graph",
        "action_center",
        "research",
        "infrastructure"
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "name",
        "short_name",
        "description",
        "primary_category",
        "capabilities",
        "endpoints",
        "authentication",
        "access",
        "commercial_use",
        "redistribution",
        "rate_limits",
        "data_characteristics",
        "sunrey",
        "verification"
      ],
      "properties": {
        "provider_id": { "$ref": "#/$defs/provider_id" },
        "name": { "type": "string", "minLength": 1 },
        "short_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "primary_category": { "$ref": "#/$defs/category" },
        "secondary_categories": {
          "type": "array",
          "items": { "$ref": "#/$defs/category" },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "endpoints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base_url", "api_version", "documentation_url", "status_url"],
          "properties": {
            "base_url": { "type": ["string", "null"], "format": "uri" },
            "api_version": { "type": ["string", "null"] },
            "documentation_url": { "type": ["string", "null"], "format": "uri" },
            "status_url": { "type": ["string", "null"], "format": "uri" }
          }
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "required", "registration_required", "environment_variable"],
          "properties": {
            "type": { "$ref": "#/$defs/authentication_type" },
            "required": { "type": "boolean" },
            "registration_required": { "type": "boolean" },
            "environment_variable": { "type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]*$" },
            "notes": { "type": ["string", "null"] }
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "free_tier_verified", "registration_required"],
          "properties": {
            "status": { "$ref": "#/$defs/free_access_status" },
            "free_tier_verified": { "type": "boolean" },
            "registration_required": { "type": "boolean" },
            "notes": { "type": ["string", "null"] }
          }
        },
        "commercial_use": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "notes"],
          "properties": {
            "status": { "$ref": "#/$defs/commercial_use_status" },
            "notes": { "type": ["string", "null"] }
          }
        },
        "redistribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "notes"],
          "properties": {
            "status": { "$ref": "#/$defs/redistribution_status" },
            "notes": { "type": ["string", "null"] }
          }
        },
        "rate_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "documented",
            "requests_per_second",
            "requests_per_minute",
            "requests_per_hour",
            "requests_per_day",
            "monthly_quota",
            "concurrency_limit",
            "notes"
          ],
          "properties": {
            "documented": { "type": "boolean" },
            "requests_per_second": { "type": ["number", "null"] },
            "requests_per_minute": { "type": ["number", "null"] },
            "requests_per_hour": { "type": ["number", "null"] },
            "requests_per_day": { "type": ["number", "null"] },
            "monthly_quota": { "type": ["number", "null"] },
            "concurrency_limit": { "type": ["number", "null"] },
            "notes": { "type": ["string", "null"] }
          }
        },
        "data_characteristics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "freshness",
            "geographic_scope",
            "historical_data",
            "realtime",
            "data_format",
            "notes"
          ],
          "properties": {
            "freshness": {
              "type": ["string", "null"],
              "enum": [
                "realtime",
                "delayed",
                "daily",
                "weekly",
                "monthly",
                "historical",
                null
              ]
            },
            "geographic_scope": {
              "type": "array",
              "items": { "type": "string" }
            },
            "historical_data": { "type": ["boolean", "null"] },
            "realtime": { "type": ["boolean", "null"] },
            "data_format": { "type": ["string", "null"] },
            "notes": { "type": ["string", "null"] }
          }
        },
        "sunrey": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "domain",
            "canonical_provider_interface",
            "priority",
            "launch_tier",
            "authority_class"
          ],
          "properties": {
            "domain": {
              "type": "array",
              "items": { "$ref": "#/$defs/sunrey_domain" },
              "minItems": 1,
              "uniqueItems": true
            },
            "canonical_provider_interface": { "type": ["string", "null"] },
            "priority": { "$ref": "#/$defs/priority" },
            "launch_tier": { "$ref": "#/$defs/launch_tier" },
            "authority_class": { "$ref": "#/$defs/authority_class" },
            "integration_state": {
              "type": ["string", "null"],
              "enum": [
                "not_integrated",
                "catalog_only",
                "simulated",
                "sandbox",
                "production_candidate",
                null
              ]
            },
            "existing_adapter": { "type": ["string", "null"] }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "verified_against_official_docs",
            "last_verified",
            "notes"
          ],
          "properties": {
            "status": { "$ref": "#/$defs/verification_status" },
            "verified_against_official_docs": { "type": "boolean" },
            "last_verified": { "type": ["string", "null"], "format": "date" },
            "notes": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}
