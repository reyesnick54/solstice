{
  "schemaVersion": "2.0",
  "id": "example-ema-cross",
  "name": "EMA cross",
  "description": "Reference fixture for NATIVE06 translation tests (upstream BYTEX example-ema-cross).",
  "metadata": {
    "template": true,
    "tags": ["trend", "example"],
    "provenance": "bytex@67b3e10 Examples/ema-cross.json"
  },
  "instruments": [{ "ref": "primary", "marketKey": "bx-market:v2/SIM/BTCUSDT" }],
  "candleSeriesDefinitions": [
    {
      "ref": "main",
      "instrument": "primary",
      "step": 1,
      "aggregation": "minute",
      "priceType": "last",
      "source": "provider"
    }
  ],
  "parameters": [
    { "name": "fast", "type": "int", "label": "Fast EMA", "value": "10", "min": "2", "max": "200", "step": "1" },
    { "name": "slow", "type": "int", "label": "Slow EMA", "value": "30", "min": "3", "max": "400", "step": "1" },
    { "name": "size", "type": "decimal", "label": "Trade size (BTC)", "value": "0.5", "min": "0.001", "max": "10", "step": "0.1" }
  ],
  "nodes": [
    { "id": "bars", "type": "data.bars", "params": { "candleSeries": "main" } },
    { "id": "fast", "type": "ind.ema", "params": { "period": { "$param": "fast" } } },
    { "id": "slow", "type": "ind.ema", "params": { "period": { "$param": "slow" } } },
    { "id": "crossUp", "type": "cond.cross", "params": { "direction": "above" } },
    { "id": "crossDown", "type": "cond.cross", "params": { "direction": "below" } },
    { "id": "buy", "type": "act.order", "params": { "side": "buy", "orderType": "market", "sizing": { "mode": "fixed", "value": { "$param": "size" } }, "onlyWhenFlat": true } },
    { "id": "exit", "type": "act.close" }
  ],
  "edges": [
    { "from": "bars:bars", "to": "fast:bars" },
    { "from": "bars:bars", "to": "slow:bars" },
    { "from": "fast:value", "to": "crossUp:value" },
    { "from": "slow:value", "to": "crossUp:reference" },
    { "from": "fast:value", "to": "crossDown:value" },
    { "from": "slow:value", "to": "crossDown:reference" },
    { "from": "crossUp:out", "to": "buy:trigger" },
    { "from": "crossDown:out", "to": "exit:trigger" }
  ],
  "repeat": { "enabled": true }
}
