{
  "name": "solstice",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "solstice",
      "version": "0.1.0",
      "workspaces": [
        "packages/*",
        "services/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/@solstice/accounts": {
      "resolved": "services/accounts",
      "link": true
    },
    "node_modules/@solstice/compliance-kernel": {
      "resolved": "packages/compliance-kernel",
      "link": true
    },
    "node_modules/@solstice/domain": {
      "resolved": "packages/domain",
      "link": true
    },
    "node_modules/@solstice/evidence-vault": {
      "resolved": "packages/evidence-vault",
      "link": true
    },
    "node_modules/@solstice/flags": {
      "resolved": "packages/flags",
      "link": true
    },
    "node_modules/@solstice/permissions": {
      "resolved": "packages/permissions",
      "link": true
    },
    "packages/compliance-kernel": {
      "name": "@solstice/compliance-kernel",
      "version": "0.1.0",
      "dependencies": {
        "@solstice/evidence-vault": "*",
        "@solstice/flags": "*",
        "@solstice/permissions": "*"
      },
      "engines": {
        "node": ">=22"
      }
    },
    "packages/domain": {
      "name": "@solstice/domain",
      "version": "0.1.0",
      "engines": {
        "node": ">=22"
      }
    },
    "packages/evidence-vault": {
      "name": "@solstice/evidence-vault",
      "version": "0.1.0",
      "dependencies": {
        "@solstice/permissions": "*"
      },
      "engines": {
        "node": ">=22"
      }
    },
    "packages/flags": {
      "name": "@solstice/flags",
      "version": "0.1.0",
      "engines": {
        "node": ">=22"
      }
    },
    "packages/permissions": {
      "name": "@solstice/permissions",
      "version": "0.1.0",
      "engines": {
        "node": ">=22"
      }
    },
    "services/accounts": {
      "name": "@solstice/accounts",
      "version": "0.1.0",
      "dependencies": {
        "@solstice/compliance-kernel": "*",
        "@solstice/domain": "*",
        "@solstice/evidence-vault": "*",
        "@solstice/flags": "*",
        "@solstice/permissions": "*"
      },
      "engines": {
        "node": ">=22"
      }
    }
  }
}
